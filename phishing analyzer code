# Main analyzer
# ============================================================
def analyze_email(file_path):
    print("=" * 70)
    print("             PHISHING EMAIL DETECTOR")
    print("=" * 70)
    findings = []
    # --------------------------------------------------------
    # Parse EML
    # --------------------------------------------------------
    try:
        with open(
            file_path,
            "rb"
        ) as file:
            msg = BytesParser(
                policy=policy.default
            ).parse(file)
    except Exception as error:
        print("Error reading email:")
        print(error)
        return
    # --------------------------------------------------------
    # Basic information
    # --------------------------------------------------------
    print("\n--- EMAIL INFORMATION ---")
    print(
        "From   :",
        msg.get("From", "Unknown")
    )
    print(
        "To     :",
        msg.get("To", "Unknown")
    )
    print(
        "Subject:",
        msg.get("Subject", "Unknown")
    )
    print(
        "Date   :",
        msg.get("Date", "Unknown")
    )
    # --------------------------------------------------------
    # Authentication
    # --------------------------------------------------------
    print("\n--- AUTHENTICATION ---")
    analyze_authentication(
        msg,
        findings
    )
    # --------------------------------------------------------
    # Headers
    # --------------------------------------------------------
    analyze_headers(
        msg,
        findings
    )
    # --------------------------------------------------------
    # Body
    # --------------------------------------------------------
    plain_text, html_text = extract_body(
        msg
    )
    combined_text = (
        plain_text +
        "\n" +
        html_text
    )
    # --------------------------------------------------------
    # Social engineering
    # --------------------------------------------------------
    analyze_social_engineering(
        combined_text,
        findings
    )
    # --------------------------------------------------------
    # URLs from plain text
    # --------------------------------------------------------
    print("\n--- URL ANALYSIS ---")
    urls = extract_urls(
        combined_text
    )
    # URLs from HTML
    html_urls = extract_html_urls(
        html_text
    )
    urls.extend(html_urls)
    urls = list(set(urls))
    if urls:
        print(
            f"Found {len(urls)} URL(s)"
        )
        for url in urls:
            print("\nChecking:", url)
            analyze_url(
                url,
                findings
            )
    else:
        print("No URLs found.")
    # --------------------------------------------------------
    # Attachments
    # --------------------------------------------------------
    analyze_attachments(
        msg,
        findings
    )
    # --------------------------------------------------------
    # Final report
    # --------------------------------------------------------
    score = calculate_score(
        findings
    )
    risk = get_risk_level(
        score
    )
    print("\n")
    print("=" * 70)
    print("                    FINAL REPORT")
    print("=" * 70)
    print(
        f"\nRisk Score : {score}/100"
    )
    print(
        f"Risk Level : {risk}"
    )
    # --------------------------------------------------------
    # Findings
    # --------------------------------------------------------
    if findings:
        print("\n--- DETECTION FINDINGS ---")
        for number, finding in enumerate(
            findings,
            start=1
        ):
            print(
                f"\n[{number}] "
                f"{finding['severity']} | "
                f"{finding['category']}"
            )
            print(
                f"    {finding['message']}"
            )
    else:
        print(
            "\nNo suspicious indicators detected."
        )
    print("\n")
    print("=" * 70)
    print(
        "SOC Analyst Summary:"
    )
    if risk == "CRITICAL":
        print(
            "Highly suspicious email. "
            "Multiple phishing indicators detected."
        )
    elif risk == "HIGH":
        print(
            "High-risk email. "
            "Further investigation is recommended."
        )
    elif risk == "MEDIUM":
        print(
            "Potentially suspicious email. "
            "Manual investigation recommended."
        )
    else:
        print(
            "No major phishing indicators detected."
        )
    print("=" * 70)
